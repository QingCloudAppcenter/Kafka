flush /etc/logrotate.d/journald << LOGROTATE_EOF
${DATA_MOUNTS}/log/journald/journald.log {
    daily
    rotate 20
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    postrotate
        /usr/bin/systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
    endscript
}
LOGROTATE_EOF